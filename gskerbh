<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>One Year With You ♡</title>
<style>
:root{--wine:#67000d;--rose:#7a313a;--blush:#fbc0c8;--cream:#f0ede6;--kraft:#e6d5b8;--ink:#3d2a28;
--script:"Segoe Script","Bradley Hand","Snell Roundhand","Brush Script MT","Apple Chancery",cursive;
--serif:"Old Standard TT","Bodoni 72","Didot",Georgia,"Times New Roman",serif}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;height:100%;overflow:hidden;background:var(--kraft)}
body{font-family:var(--serif);color:var(--ink);
background:radial-gradient(circle at 20% 15%,rgba(255,255,255,.35),transparent 45%),
radial-gradient(circle at 85% 90%,rgba(120,80,40,.18),transparent 50%),
repeating-linear-gradient(45deg,rgba(120,85,45,.04) 0 2px,transparent 2px 5px),var(--kraft)}
.page{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;
padding:max(14px,env(safe-area-inset-top)) 14px calc(66px + env(safe-area-inset-bottom));
opacity:0;pointer-events:none;transform:translateX(9%) rotate(1.2deg);
transition:opacity .6s ease,transform .7s cubic-bezier(.3,.7,.2,1);overflow:hidden}
.page.active{opacity:1;pointer-events:auto;transform:none}
.page.past{transform:translateX(-9%) rotate(-1.2deg)}
.gingham{background:
linear-gradient(90deg,rgba(255,255,255,.55) 50%,transparent 50%) 0 0/44px 44px,
linear-gradient(rgba(255,255,255,.55) 50%,transparent 50%) 0 0/44px 44px,var(--rose)}
.wine{background:var(--wine)}
.art{position:relative;container-type:inline-size;aspect-ratio:3/4;
width:min(100%,calc((100dvh - 96px) * .75),520px)}
.art img{display:block;width:100%;height:100%;border-radius:3px;box-shadow:0 2px 3px rgba(0,0,0,.25),0 14px 28px rgba(60,20,20,.32)}
.tape{position:absolute;width:26cqw;height:7cqw;background:rgba(251,192,200,.72);
box-shadow:0 1px 3px rgba(0,0,0,.2);z-index:3;
background-image:repeating-linear-gradient(90deg,rgba(255,255,255,.35) 0 3px,transparent 3px 7px)}
.tape.a{top:-3cqw;left:-5cqw;transform:rotate(-38deg)}
.tape.b{top:-3cqw;right:-5cqw;transform:rotate(36deg)}
.tape.c{bottom:-2cqw;right:-4cqw;transform:rotate(-30deg)}
.note{position:absolute;font-family:var(--script);color:var(--wine);z-index:3;line-height:1.2}
.heart{position:absolute;color:#c4455a;z-index:3;pointer-events:none}
/* cover */
#p0 .art{cursor:pointer;transition:transform .55s cubic-bezier(.3,.7,.2,1),opacity .5s;transform:rotate(-1.2deg);
animation:bob 3.2s ease-in-out infinite}
#p0 .art:hover{transform:rotate(0) translateY(-6px)}
#p0 .art.open{animation:none;transform:perspective(900px) rotateY(-32deg) translateX(-6%) scale(.97);transform-origin:left center;opacity:.6}
@keyframes bob{50%{translate:0 -5px}}
.hint{position:absolute;left:0;right:0;bottom:7cqw;text-align:center;font-family:var(--script);color:var(--wine);font-size:4.4cqw;z-index:3}
.hint b{display:inline-block;animation:pulse 1.6s ease-in-out infinite;font-weight:400}
@keyframes pulse{50%{transform:scale(1.2)}}
/* letter */
.paper{position:relative;width:min(100%,540px);max-height:100%;overflow:auto;background:
radial-gradient(rgba(120,110,100,.12) 1px,transparent 1.2px) 0 0/5px 5px,#efece6;
padding:clamp(22px,6vw,40px) clamp(18px,5vw,34px);text-align:center;
border-radius:6px 14px 8px 16px / 12px 6px 14px 8px;
box-shadow:0 2px 4px rgba(0,0,0,.25),0 18px 34px rgba(40,10,15,.45);transform:rotate(-.6deg);
font-size:clamp(15px,4.3vw,21px);line-height:1.5;font-weight:700}
.paper p{margin:0 0 .55em}
.paper .sign{text-align:right;padding-right:6%;margin-top:.9em}
.scrap{position:absolute;background:#b79a9a;z-index:0;opacity:.85}
.scrap.s1{width:55vw;max-width:340px;height:30vh;top:2vh;right:-6vw;clip-path:polygon(8% 0,100% 0,100% 90%,70% 100%,40% 88%,0 92%,6% 40%)}
.scrap.s2{width:60vw;max-width:360px;height:28vh;bottom:6vh;left:-8vw;clip-path:polygon(0 12%,45% 0,100% 14%,92% 60%,100% 100%,30% 94%,0 100%)}
#p2 .paper,#p3 .env,#p3 .env-wrap{z-index:2}
/* envelope */
.env-wrap{display:flex;flex-direction:column;align-items:center;gap:6vh;position:relative}
.env{position:relative;width:min(84vw,420px);aspect-ratio:4/3;cursor:pointer;
transition:transform .5s;animation:bob 3.2s ease-in-out infinite;filter:drop-shadow(0 16px 20px rgba(30,5,10,.5))}
.env:hover{transform:translateY(-6px)}
.env>*{position:absolute;left:0;right:0}
.env .back{inset:0;background:#d8cbb3;border-radius:4px}
.env .card{left:7%;right:7%;top:6%;height:84%;background:#fff8ee;border-radius:4px;z-index:2;
display:flex;align-items:center;justify-content:center;flex-direction:column;text-align:center;
font-family:var(--script);color:var(--wine);font-size:clamp(17px,5vw,24px);line-height:1.5;
transition:transform .9s .35s cubic-bezier(.3,.7,.2,1);box-shadow:0 1px 3px rgba(0,0,0,.25)}
.env .pocket{inset:0;z-index:4;background:linear-gradient(160deg,#e9e0cf,#dccfb6);border-radius:4px;
clip-path:polygon(0 0,50% 56%,100% 0,100% 100%,0 100%)}
.env .flap{top:0;height:58%;z-index:5;background:linear-gradient(#e6dcc8,#d6c8ad);
clip-path:polygon(0 0,100% 0,50% 100%);transform-origin:top center;transition:transform .6s ease,z-index 0s .3s}
.env .seal{z-index:6;left:50%;right:auto;top:48%;width:13%;aspect-ratio:1;transform:translate(-50%,-50%);
background:#8e1b2c;border-radius:50%;color:#fbc0c8;display:flex;align-items:center;justify-content:center;
font-size:clamp(14px,4.4vw,22px);box-shadow:0 2px 4px rgba(0,0,0,.4);transition:opacity .3s}
.env.open{animation:none}
.env.open .flap{transform:rotateX(180deg);z-index:1}
.env.open .seal{opacity:0}
.env.open .card{transform:translateY(-52%)}
.env-phrase{font-family:var(--script);color:var(--cream);font-size:clamp(20px,6vw,30px);text-align:center;
text-shadow:0 2px 6px rgba(0,0,0,.5);margin:0;z-index:2;padding:0 10px}
/* quiz */
.quiz-btn{position:absolute;z-index:4;left:27%;top:56.4%;width:46%;height:11.5%;display:flex;align-items:center;justify-content:center;
text-align:center;text-decoration:none;background:var(--blush);color:#8a1026;font:900 3.5cqw/1.15 var(--serif);
border:.7cqw dashed #8a1026;border-radius:999px;box-shadow:0 1cqw 0 #d89aa6,0 3cqw 5cqw rgba(0,0,0,.4);
transform:rotate(-2deg);animation:wob 2.2s ease-in-out infinite;padding:0 2cqw}
.quiz-btn:active{transform:scale(.96) rotate(-2deg)}
@keyframes wob{50%{transform:rotate(1.5deg) scale(1.04)}}
.good-luck{position:absolute;left:25%;width:50%;top:69.5%;text-align:center;font-family:var(--script);color:var(--blush);font-size:4.2cqw;z-index:3}
/* nav */
.nav{position:fixed;z-index:20;font-family:var(--script);border:0;cursor:pointer;color:var(--wine);
background:rgba(255,248,238,.9);border-radius:999px;box-shadow:0 2px 6px rgba(0,0,0,.3);transition:opacity .3s,transform .2s}
.nav:active{transform:scale(.94)}
#back{top:max(10px,env(safe-area-inset-top));left:12px;width:42px;height:42px;font-size:20px;opacity:.75}
#next{bottom:max(12px,env(safe-area-inset-bottom));left:50%;translate:-50% 0;padding:12px 26px;font-size:17px;min-height:44px}
.nav.hide{opacity:0;pointer-events:none}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition-duration:.01s!important}}
</style>
</head>
<body>

<section class="page active" id="p0">
 <div class="art" id="cover" role="button" tabindex="0" aria-label="Open the card">
  <span class="tape a"></span><span class="tape b"></span>
  <img src="data:image/jpeg;base64," alt="Happy Anniversary cover with two heart lockets, S and N">
  <div class="hint"><b>♡</b> tap to open <b>♡</b></div>
 </div>
</section>

<section class="page" id="p1">
 <div class="art">
  <span class="tape a"></span><span class="tape b"></span>
  <img src="data:image/jpeg;base64," alt="Our Month calendar with the 5th circled by a heart and arrow">
  <span class="heart" style="left:8%;bottom:9%;font-size:7cqw">♡</span>
  <span class="heart" style="right:10%;bottom:14%;font-size:5cqw;transform:rotate(14deg)">♥</span>
  <div class="note" style="left:12%;bottom:6%;font-size:4.6cqw;transform:rotate(-4deg)">the day it all began ♡</div>
 </div>
</section>

<section class="page gingham" id="p2">
 <div class="scrap s1"></div><div class="scrap s2"></div>
 <div class="paper" aria-label="Anniversary letter">
  <span class="tape a" style="width:90px;height:26px;top:-10px;left:-18px"></span>
  <span class="tape b" style="width:90px;height:26px;top:-10px;right:-18px"></span>
  <p>Dear Bub,</p>
  <p>I can’t believe it's already been 365 days with you, and I've even known for much more than that. You’re one of the few people that’s been in my life this long, and honestly, if you had asked me about that two years ago, I would have just been extremely confused.</p>
  <p>I can’t say I thought it was going to be easy, and well, it wasn't, but somehow it’s still amazing doing this with you.</p>
  <p>I think about how lucky I am to have you. You always try to help me in every way you can, and you’re always the first person I run to. In my head, you’re literally my fix, Felix.</p>
  <p>I love the way you laugh and the way we laugh together. I love the way we can banter, be all lovey dovey and even fight but fix it.</p>
  <p>I love loving you. Happy one-year anniversary (please ignore all of the 52 different fonts used)</p>
  <p class="sign">-your amazing sexy girlfriend 4ever</p>
 </div>
</section>

<section class="page gingham" id="p3">
 <div class="scrap s1"></div><div class="scrap s2"></div>
 <div class="env-wrap">
  <p class="env-phrase" id="phrase">Wait... we're not finished yet ♡</p>
  <div class="env" id="env" role="button" tabindex="0" aria-label="Open the envelope">
   <div class="back"></div>
   <div class="card"><span>p.s. i love u ♡</span><span style="font-size:.7em">one more thing...</span></div>
   <div class="pocket"></div>
   <div class="flap"></div>
   <div class="seal">♥</div>
  </div>
 </div>
</section>

<section class="page wine" id="p4">
 <div class="art">
  <img src="data:image/jpeg;base64," alt="Take the 1 year anniversary quiz">
  <a class="quiz-btn" id="quizLink" href="https://crossword.littleweb.world/link/crossword/p/fbcc6c93-ca2f-480d-9fec-c53bfa9a05ae" target="_blank" rel="noopener noreferrer">CLICK HERE TO TAKE THE QUIZ ♡</a>
  <div class="good-luck">Good luck, baby ♡</div>
 </div>
</section>

<button class="nav hide" id="back" aria-label="Go back">←</button>
<button class="nav hide" id="next">turn the page ♡</button>

<script>
(function(){
 var pages=[].slice.call(document.querySelectorAll('.page')),cur=0,lock=false;
 var back=document.getElementById('back'),next=document.getElementById('next');
 var env=document.getElementById('env'),cover=document.getElementById('cover'),timer;
 function show(n){
  clearTimeout(timer);
  pages.forEach(function(p,i){p.classList.toggle('active',i===n);p.classList.toggle('past',i<n)});
  cur=n;
  back.classList.toggle('hide',n===0);
  next.classList.toggle('hide',!(n===1||n===2));
  if(n!==3)env.classList.remove('open');
  if(n!==0)cover.classList.remove('open');
  if(n===3)document.getElementById('phrase').textContent="Wait... we're not finished yet ♡";
 }
 function go(n){if(lock||n<0||n>4)return;lock=true;show(n);setTimeout(function(){lock=false},650)}
 function openCover(){if(cur!==0||lock)return;cover.classList.add('open');setTimeout(function(){go(1)},420)}
 function openEnv(){
  if(cur!==3)return;
  if(env.classList.contains('open')){go(4);return}
  env.classList.add('open');
  document.getElementById('phrase').textContent="There's one more thing for you... ♡";
  timer=setTimeout(function(){go(4)},2600);
 }
 function key(el,fn){el.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();fn()}})}
 cover.addEventListener('click',openCover);key(cover,openCover);
 env.addEventListener('click',openEnv);key(env,openEnv);
 next.addEventListener('click',function(){go(cur+1)});
 back.addEventListener('click',function(){go(cur-1)});
 show(0);
})();
</script>
</body>
</html>
